{
  "name": "Rifa Solidária - Notificação com Enquete no WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rifa-novo-pedido",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1187d9a1-8d2a-4a25-b461-862d854ce112",
      "name": "Webhook Rifa",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "rifa-novo-pedido"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json.body || $input.first().json;\n\n// TRAVA ANTI-LOOP: ignora se não for um pedido novo vindo do sistema de rifa\nif (item.event !== 'order_created' || !item.orderId) {\n  return [];\n}\n\nconst totalFormatted = Number(item.totalAmount || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst cotas = Array.isArray(item.selectedNumbers) ? item.selectedNumbers.join(', ') : item.selectedNumbers;\n\n// Título da enquete\nconst pollName = `🔔 PIX RIFA: R$ ${totalFormatted}\\n` +\n  `👤 ${item.customerName} (${item.customerPhone})\\n` +\n  `🎫 Cotas (${item.numbersCount}): ${cotas}\\n\\n` +\n  `O PIX caiu na sua conta?`;\n\nreturn [{\n  json: {\n    ...item,\n    totalFormatted,\n    cotas,\n    pollName,\n    adminPhone: item.adminPhone || '556392917027'\n  }\n}];"
      },
      "id": "b0a2cf31-419b-4375-a86a-733d9f10ca24",
      "name": "Formatar Dados (com Trava)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evo2.agenciahigher.com.br/message/sendPoll/rifasolidária",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "Lumina2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  number: $json.adminPhone,\n  name: $json.pollName,\n  values: [\n    \"✅ Confirmar Pagamento\",\n    \"❌ Cancelar Pedido\"\n  ],\n  selectableCount: 1\n}) }}",
        "options": {}
      },
      "id": "78ff0f81-2287-4340-84cf-341a99564cb1",
      "name": "Enviar Enquete no WhatsApp",
